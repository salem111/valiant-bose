# Production environment template for SALEEM
# ضع القيم الحقيقية في مدير أسرار الخادم فقط، ولا تحفظها في Git.

NODE_ENV=production
PORT=3000

# Firebase server verification
FIREBASE_PROJECT_ID=salem-adae3
FIREBASE_DATABASE_URL=

# Frontend/public configuration
VITE_SERVER_API_BASE_URL=https://api.example.com
VITE_AGORA_APP_ID=

# Keep this only until the final LiveKit migration is completed.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Server-only AI secret
GEMINI_API_KEY=

# Exact production origins only
CORS_ORIGIN=https://app.example.com,https://localhost,capacitor://localhost

# Future LiveKit migration variables; do not enable until the audio phase.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
